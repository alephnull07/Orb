{
  "_comment": "toy_water_sinks.json + two independent sensors at BASE_B: a drain meter (m1) and a level sensor (m2). This raises correctable_k from 0 to 1.",
  "lambda_sink": 0.01,
  "nodes": [
    {"id": "DEPOT",  "initial": 1000, "sinks": "none"},
    {"id": "BASE_A", "initial": 0,    "sinks": "none"},
    {"id": "BASE_B", "initial": 0,    "sinks": "unknown"},
    {"id": "BASE_C", "initial": 0,    "sinks": "none"}
  ],
  "edges": [
    {"id": "e1", "from": "DEPOT", "to": "BASE_A"},
    {"id": "e2", "from": "DEPOT", "to": "BASE_B"},
    {"id": "e3", "from": "DEPOT", "to": "BASE_C"}
  ],
  "claims": [
    {"id": "c1", "type": "node", "ref": "DEPOT",  "value": 200, "source": "depot_manifest", "weight": 1.0},
    {"id": "c2", "type": "edge", "ref": "e1",     "value": 300, "source": "agent_A",        "weight": 0.8},
    {"id": "c3", "type": "edge", "ref": "e2",     "value": 400, "source": "agent_B",        "weight": 0.8},
    {"id": "c4", "type": "edge", "ref": "e3",     "value": 100, "source": "agent_C",        "weight": 0.8},
    {"id": "c5", "type": "node", "ref": "BASE_A", "value": 300, "source": "agent_A",        "weight": 0.8},
    {"id": "c6", "type": "node", "ref": "BASE_B", "value": 380, "source": "agent_B",        "weight": 0.8},
    {"id": "c7", "type": "node", "ref": "BASE_C", "value": 100, "source": "agent_C",        "weight": 0.8},
    {"id": "m1", "type": "sink", "ref": "BASE_B", "value": 20,  "source": "drain_meter",    "weight": 1.0},
    {"id": "m2", "type": "node", "ref": "BASE_B", "value": 380, "source": "level_sensor",   "weight": 1.0}
  ]
}
